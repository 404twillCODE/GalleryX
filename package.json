{
  "name": "galleryx",
  "version": "0.1.0",
  "description": "GalleryX — a fast, beautiful, offline photo browser for large external drive libraries",
  "author": "GalleryX",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && electron-vite build",
    "build:check": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "pretest": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "posttest": "electron-rebuild -f -w better-sqlite3",
    "test:watch": "vitest",
    "pregen:testlibrary": "npm rebuild better-sqlite3",
    "gen:testlibrary": "tsx scripts/generateTestLibrary.ts",
    "postgen:testlibrary": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "npm run build:check && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:win": "npm run build:check && electron-builder --win --x64 --publish never",
    "dist": "npm run build:check && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --win --x64 --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.451.0",
    "sharp": "^0.33.5",
    "uuid": "^9.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@tanstack/react-virtual": "^3.10.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^4.1.10"
  }
}
